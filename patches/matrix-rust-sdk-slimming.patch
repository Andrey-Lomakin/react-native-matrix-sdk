-impl From<UISpaceFilter> for SpaceFilter {
-    fn from(filter: UISpaceFilter) -> Self {
-        SpaceFilter {
-            space_room: filter.space_room.into(),
-            level: filter.level,
-            descendants: filter.descendants.into_iter().map(|id| id.to_string()).collect(),
-        }
-    }
-}
